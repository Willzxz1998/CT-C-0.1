# Copy to Streamlit Cloud → Settings → Secrets (or local .streamlit/secrets.toml).
# SusTool does NOT use email login in application code.
# Set app visibility to "Public" in Streamlit Cloud → Sharing to remove email allow-list.

# Optional: enable maintainer tools without password on trusted deployments only.
# creator_mode = false

# Optional: password for ?maintainer=1 unlock (default from env SUSTOOL_CREATOR_PASSWORD).
# creator_password = "your-secure-password"
